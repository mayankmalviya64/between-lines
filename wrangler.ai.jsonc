{
  "name": "between-lines-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "ai": {"binding": "AI"},
  "vars": {"ALLOWED_ORIGIN": "https://mayankmalviya64.github.io"},
  "durable_objects": {"bindings": [{"name": "AI_BUDGET", "class_name": "DailyAiBudget"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["DailyAiBudget"]}],
  "observability": {"enabled": false}
}
